{
	"files.exclude": {
		"**/node_modules": true,
		"**/coverage": true,
		"**/dist": true,
		"**/build": true,
		"**/.next": true,
		"**/storybook-static": true,
		"**/build-storybook.log": true
	},
	"search.exclude": {
		"**/package-lock.json": true
	},
	"json.schemas": [
		{
			"fileMatch": ["/resume.config.json"],
			"url": "./schema/resume.schema.json"
		},
		{
			"fileMatch": ["/data/site.json"],
			"url": "./schema/resume.schema.json#/$defs/site"
		},
		{
			"fileMatch": ["/data/person.json"],
			"url": "./schema/resume.schema.json#/$defs/person"
		},
		{
			"fileMatch": ["/data/summary.json"],
			"url": "./schema/resume.schema.json#/$defs/summary"
		},
		{
			"fileMatch": ["/data/skills.json"],
			"url": "./schema/resume.schema.json#/$defs/skills"
		},
		{
			"fileMatch": ["/data/awards.json"],
			"url": "./schema/resume.schema.json#/$defs/awards"
		},
		{
			"fileMatch": ["/data/education.json"],
			"url": "./schema/resume.schema.json#/$defs/education"
		},
		{
			"fileMatch": ["/data/experience/*.json", "/data/volunteering/*.json"],
			"url": "./schema/resume.schema.json#/$defs/role"
		},
		{
			"fileMatch": ["/layouts/*.json"],
			"url": "./schema/resume.schema.json#/$defs/layout"
		}
	],
	"editor.rulers": [80, 100, 120],
	// remove trailing whitespace
	"files.trimTrailingWhitespace": true,
	// set eslint as the default formatter
	"editor.defaultFormatter": "biomejs.biome",
	// required
	"editor.formatOnPaste": false,
	// required
	"editor.formatOnType": false,
	// optional
	"editor.formatOnSave": true,
	"editor.codeActionsOnSave": {
		"source.formatDocument": "explicit",
		"source.addMissingImports": "explicit",
		"source.organizeImports": "explicit",
		"source.fixAll.eslint": "explicit",
		"source.fixAll": "explicit"
	},
	"eslint.enable": true,
	"eslint.run": "onSave",
	"eslint.validate": [
		"javascript",
		"json",
		"typescript",
		"typescriptreact",
		"yaml"
	],
	"eslint.codeActionsOnSave.rules": ["*semi*", "*"],
	// required to format on save
	"editor.formatOnSaveMode": "file",
	"eslint.format.enable": true,
	// optional but recommended
	"files.autoSave": "onFocusChange",
	"editor.cursorBlinking": "smooth",
	"editor.cursorSmoothCaretAnimation": "on",
	"[markdown]": {
		"editor.formatOnSave": true,
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescript]": {
		"editor.formatOnSave": true,
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[javascript]": {
		"editor.formatOnSave": true,
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[yamlgithubactionsworkflow]": {
		"editor.defaultFormatter": "redhat.vscode-yaml",
		"editor.tabSize": 2,
		"editor.formatOnSave": true,
		"editor.formatOnType": true
	},
	"[jsonc]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[json]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[html]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[css]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[postcss]": {
		"editor.defaultFormatter": "biomejs.biome"
	}
}
