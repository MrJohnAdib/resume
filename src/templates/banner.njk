{% if site.banner.enabled %}
<div id="banner" class="select-none relative isolate flex items-center gap-x-6 overflow-hidden bg-gray-50 px-6 py-2.5 sm:px-3.5 sm:before:flex-1 dark:bg-gray-900">
	{% for position in ["left-[max(-7rem,calc(50%-52rem))]", "left-[max(45rem,calc(50%+8rem))]"] %}
	<div class="absolute {{ position }} top-1/2 -z-10 -translate-y-1/2 transform-gpu blur-2xl" aria-hidden="true">
		<div class="aspect-[577/310] w-[36.0625rem] bg-gradient-to-r opacity-30"
			style="background-image:linear-gradient(to right,{{ site.banner.gradientFrom }},{{ site.banner.gradientTo }});clip-path:{{ site.banner.clipPath }}"></div>
	</div>
	{% endfor %}
	<div class="flex flex-wrap items-center gap-x-4 gap-y-2 grow">
		<p class="text-xs md:text-sm leading-normal md:leading-8 text-gray-900 dark:text-gray-100">
			{{ site.banner.messageBefore }}
			<strong class="font-semibold">{{ site.banner.technology }}</strong>{{ site.banner.messageAfter }}
			<a href="{{ site.banner.linkUrl }}" target="_blank" class="whitespace-nowrap hover:text-cyan-500 transition-colors">
				{{ site.banner.linkLabel }}
			</a>
		</p>
		<a id="pdf-btn" href="{{ site.metadata.url }}" target="_blank"
			class="relative flex-none rounded-lg bg-gray-900 dark:bg-gray-100 px-5 py-2 text-xs md:text-sm font-semibold text-white dark:text-gray-900 shadow-sm hover:bg-gray-700 dark:hover:bg-gray-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 select-none transition-all">
			{{ site.pdf.buttonLabel }}
			<span class="flex absolute -top-1 -right-1 h-3 w-3">
				<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"></span>
				<span class="relative inline-flex rounded-full h-3 w-3 bg-sky-500"></span>
			</span>
		</a>
	</div>
</div>
{% endif %}
