{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "array",
	"items": {
		"type": "object",
		"properties": {
			"id": {
				"type": "string",
				"minLength": 1
			},
			"column": {
				"type": "string",
				"enum": [
					"left",
					"right"
				]
			}
		},
		"required": [
			"id",
			"column"
		],
		"additionalProperties": false
	}
}
