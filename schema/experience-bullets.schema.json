{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "array",
	"items": {
		"type": "object",
		"properties": {
			"id": {
				"type": "string",
				"minLength": 1,
				"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
			},
			"status": {
				"type": "string",
				"enum": [
					"current",
					"alternate",
					"archived"
				]
			},
			"text": {
				"anyOf": [
					{
						"type": "string"
					},
					{
						"type": "array",
						"items": {
							"oneOf": [
								{
									"type": "object",
									"properties": {
										"type": {
											"type": "string",
											"const": "text"
										},
										"value": {
											"type": "string"
										}
									},
									"required": [
										"type",
										"value"
									],
									"additionalProperties": false
								},
								{
									"type": "object",
									"properties": {
										"type": {
											"type": "string",
											"const": "abbr"
										},
										"value": {
											"type": "string"
										},
										"title": {
											"type": "string"
										}
									},
									"required": [
										"type",
										"value",
										"title"
									],
									"additionalProperties": false
								},
								{
									"type": "object",
									"properties": {
										"type": {
											"type": "string",
											"const": "sup"
										},
										"value": {
											"type": "string"
										}
									},
									"required": [
										"type",
										"value"
									],
									"additionalProperties": false
								}
							]
						}
					}
				]
			},
			"annotations": {
				"type": "array",
				"items": {
					"oneOf": [
						{
							"type": "object",
							"properties": {
								"type": {
									"type": "string",
									"const": "text"
								},
								"value": {
									"type": "string"
								}
							},
							"required": [
								"type",
								"value"
							],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"type": {
									"type": "string",
									"const": "abbr"
								},
								"value": {
									"type": "string"
								},
								"title": {
									"type": "string"
								}
							},
							"required": [
								"type",
								"value",
								"title"
							],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"type": {
									"type": "string",
									"const": "sup"
								},
								"value": {
									"type": "string"
								}
							},
							"required": [
								"type",
								"value"
							],
							"additionalProperties": false
						}
					]
				}
			}
		},
		"required": [
			"id",
			"text"
		],
		"additionalProperties": {}
	}
}
