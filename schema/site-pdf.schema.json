{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"version": {
			"type": "string",
			"pattern": "^v\\d+(?:\\.\\d+)+$"
		},
		"latestVersion": {
			"type": "string",
			"pattern": "^v\\d+(?:\\.\\d+)+$"
		},
		"folder": {
			"type": "string",
			"pattern": "^(?:\\.\\/)?[a-zA-Z0-9_./-]+\\/$"
		},
		"filePrefix": {
			"type": "string",
			"pattern": "^[a-zA-Z0-9_-]+$"
		},
		"buttonLabel": {
			"type": "string",
			"minLength": 1
		},
		"localAction": {
			"type": "string",
			"enum": [
				"print",
				"hide"
			]
		}
	},
	"required": [
		"version",
		"latestVersion",
		"folder",
		"filePrefix",
		"buttonLabel",
		"localAction"
	],
	"additionalProperties": false
}
