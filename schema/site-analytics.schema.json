{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"enabled": {
			"type": "boolean"
		},
		"provider": {
			"type": "string",
			"minLength": 1
		},
		"measurementId": {
			"type": "string",
			"pattern": "^[A-Z0-9-]+$"
		}
	},
	"required": [
		"enabled",
		"provider",
		"measurementId"
	],
	"additionalProperties": false
}
