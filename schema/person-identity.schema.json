{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"name": {
			"type": "string",
			"minLength": 1
		},
		"title": {
			"type": "string",
			"minLength": 1
		},
		"avatar": {
			"type": "object",
			"properties": {
				"enabled": {
					"type": "boolean"
				},
				"url": {
					"type": "string",
					"minLength": 1
				},
				"alt": {
					"type": "string"
				}
			},
			"required": [
				"enabled",
				"url",
				"alt"
			],
			"additionalProperties": false
		}
	},
	"required": [
		"name",
		"title",
		"avatar"
	],
	"additionalProperties": false
}
