{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"bodyFont": {
			"type": "string",
			"minLength": 1
		},
		"rtlFont": {
			"type": "string",
			"minLength": 1
		},
		"nameSize": {
			"type": "string",
			"pattern": "^\\d+(?:\\.\\d+)?(?:mm|px|rem|%)$"
		},
		"titleSize": {
			"type": "string",
			"pattern": "^\\d+(?:\\.\\d+)?(?:mm|px|rem|%)$"
		},
		"bodySize": {
			"type": "string",
			"pattern": "^\\d+(?:\\.\\d+)?(?:mm|px|rem|%)$"
		},
		"detailSize": {
			"type": "string",
			"pattern": "^\\d+(?:\\.\\d+)?(?:mm|px|rem|%)$"
		},
		"bodyLineHeight": {
			"type": "string",
			"pattern": "^\\d+(?:\\.\\d+)?$"
		}
	},
	"required": [
		"bodyFont",
		"rtlFont",
		"nameSize",
		"titleSize",
		"bodySize",
		"detailSize",
		"bodyLineHeight"
	],
	"additionalProperties": false
}
