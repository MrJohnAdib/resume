{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
		},
		"status": {
			"type": "string",
			"enum": [
				"current",
				"alternate",
				"archived"
			]
		},
		"title": {
			"type": "string",
			"minLength": 1
		},
		"location": {
			"type": "string"
		},
		"description": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"oneOf": [
							{
								"type": "object",
								"properties": {
									"type": {
										"type": "string",
										"const": "text"
									},
									"value": {
										"type": "string"
									}
								},
								"required": [
									"type",
									"value"
								],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"type": {
										"type": "string",
										"const": "abbr"
									},
									"value": {
										"type": "string"
									},
									"title": {
										"type": "string"
									}
								},
								"required": [
									"type",
									"value",
									"title"
								],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"type": {
										"type": "string",
										"const": "sup"
									},
									"value": {
										"type": "string"
									}
								},
								"required": [
									"type",
									"value"
								],
								"additionalProperties": false
							}
						]
					}
				}
			]
		},
		"date": {
			"type": "object",
			"properties": {
				"datetime": {
					"type": "string",
					"pattern": "^(?:\\d{4}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12]\\d|3[01]))?)?|present)$"
				},
				"label": {
					"type": "string"
				}
			},
			"required": [
				"datetime",
				"label"
			],
			"additionalProperties": false
		},
		"datePlacement": {
			"type": "string",
			"enum": [
				"before-container",
				"inside-container"
			]
		}
	},
	"required": [
		"id",
		"title",
		"location",
		"description",
		"date",
		"datePlacement"
	],
	"additionalProperties": {}
}
