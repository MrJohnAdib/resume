{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"items": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"minLength": 1,
						"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
					},
					"status": {
						"type": "string",
						"enum": [
							"current",
							"alternate",
							"archived"
						]
					},
					"label": {
						"type": "string",
						"minLength": 1
					},
					"url": {
						"type": "string",
						"format": "uri"
					},
					"title": {
						"type": "string"
					},
					"icon": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": [
					"id",
					"label",
					"url",
					"title",
					"icon"
				],
				"additionalProperties": {}
			}
		}
	},
	"required": [
		"items"
	],
	"additionalProperties": false
}
