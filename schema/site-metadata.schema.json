{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"language": {
			"type": "string",
			"minLength": 2
		},
		"direction": {
			"type": "string",
			"enum": [
				"ltr",
				"rtl"
			]
		},
		"title": {
			"type": "string",
			"minLength": 1
		},
		"description": {
			"type": "string"
		},
		"keywords": {
			"type": "string"
		},
		"date": {
			"type": "string",
			"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
		},
		"author": {
			"type": "string",
			"minLength": 1
		},
		"authorUrl": {
			"type": "string",
			"format": "uri"
		},
		"url": {
			"type": "string",
			"format": "uri"
		},
		"image": {
			"type": "string",
			"format": "uri"
		},
		"socialTitle": {
			"type": "string"
		},
		"socialDescription": {
			"type": "string"
		},
		"twitterCard": {
			"type": "string",
			"minLength": 1
		}
	},
	"required": [
		"language",
		"direction",
		"title",
		"description",
		"keywords",
		"date",
		"author",
		"authorUrl",
		"url",
		"image",
		"socialTitle",
		"socialDescription",
		"twitterCard"
	],
	"additionalProperties": false
}
